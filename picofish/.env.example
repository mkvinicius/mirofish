# LLM Configuration (OpenAI-compatible API)
# For Ollama (local, Raspberry Pi):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3

# For OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# For Qwen (Aliyun Bailian):
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-turbo

# Optional: separate embedding model (defaults to LLM_MODEL if not set)
# Use a faster/cheaper model for embeddings, e.g.:
# EMBED_MODEL=text-embedding-3-small
# EMBED_MODEL=nomic-embed-text

# Data directory (JSON files, no external DB required)
DATA_DIR=./data

# Server
PORT=5002
